# Register the finisher, validator and translations of the club form based on EXT:form
plugin.tx_form.settings.yamlConfigurations.1763337600 = EXT:clubdirectory/Configuration/Form/OverrideFormSettings.yaml

plugin.tx_clubdirectory {
  view {
    templateRootPaths {
      0 = EXT:clubdirectory/Resources/Private/Templates/
      1 = {$clubdirectory.templateRootPath}
    }
    partialRootPaths {
      0 = EXT:clubdirectory/Resources/Private/Partials/
      1 = EXT:maps2/Resources/Private/Partials/
      2 = {$clubdirectory.partialRootPath}
    }
    layoutRootPath {
      0 = EXT:clubdirectory/Resources/Private/Layouts/
      1 = {$clubdirectory.layoutRootPath}
    }
  }
  persistence {
    storagePid = {$clubdirectory.storagePid}
    updateReferenceIndex = 1
  }
  settings {
    pidOfMaps2Plugin = {$clubdirectory.pidOfMaps2Plugin}
    pidOfListPage = {$clubdirectory.pidOfListPage}
    pidOfDetailPage = {$clubdirectory.pidOfDetailPage}
    pidOfSearchResults = {$clubdirectory.pidOfSearchResults}
    pidOfManagementPage = {$clubdirectory.pidOfManagementPage}
    userGroup = {$clubdirectory.userGroup}
    list {
      image {
        width = {$clubdirectory.list.image.width}
        height= {$clubdirectory.list.image.height}
        minWidth = {$clubdirectory.list.image.minWidth}
        maxWidth = {$clubdirectory.list.image.maxWidth}
        minHeight = {$clubdirectory.list.image.minHeight}
        maxHeight = {$clubdirectory.list.image.maxHeight}
      }
    }

    show {
      logo {
        width = {$clubdirectory.show.logo.width}
        height= {$clubdirectory.show.logo.height}
        minWidth = {$clubdirectory.show.logo.minWidth}
        maxWidth = {$clubdirectory.show.logo.maxWidth}
        minHeight = {$clubdirectory.show.logo.minHeight}
        maxHeight = {$clubdirectory.show.logo.maxHeight}
      }
      image {
        width = {$clubdirectory.show.image.width}
        height= {$clubdirectory.show.image.height}
        minWidth = {$clubdirectory.show.image.minWidth}
        maxWidth = {$clubdirectory.show.image.maxWidth}
        minHeight = {$clubdirectory.show.image.minHeight}
        maxHeight = {$clubdirectory.show.image.maxHeight}
      }
    }

    new {
      # CKEditor 5 of EXT:rte_ckeditor for rich text elements of the club form
      richText {
        enable = {$clubdirectory.form.richText.enable}
        # Comma separated identifiers of form elements
        elements = {$clubdirectory.form.richText.elements}
      }
    }

    # Configuration of the club form based on EXT:form
    # See EXT:clubdirectory/Configuration/Form/NewClub.form.yaml for all values
    overrideForm {
      # Logo and images of page 1
      renderables.0.renderables.18.properties.saveToFileMount = {$clubdirectory.newUploadPath}
      renderables.0.renderables.19.properties.saveToFileMount = {$clubdirectory.newUploadPath}
      renderables.0.renderables.20.properties.saveToFileMount = {$clubdirectory.newUploadPath}
      renderables.0.renderables.21.properties.saveToFileMount = {$clubdirectory.newUploadPath}

      # New clubs and addresses are stored in the first page of storagePid
      finishers.1.options.1.databaseColumnMappings.pid.value = {$clubdirectory.storagePid}
      finishers.1.options.4.databaseColumnMappings.pid.value = {$clubdirectory.storagePid}
      finishers.1.options.5.databaseColumnMappings.pid.value = {$clubdirectory.storagePid}
      finishers.1.options.6.databaseColumnMappings.pid.value = {$clubdirectory.storagePid}

      finishers.2.options.variables.pidOfManagementPage = {$clubdirectory.pidOfManagementPage}
      finishers.5.options.pageUid = {$clubdirectory.pidOfManagementPage}
    }

    glossary {
      mergeNumbers = {$clubdirectory.glossary2.mergeNumbers}
      showAllLink = {$clubdirectory.glossary2.showAllLink}
    }

    pageBrowser {
      itemsPerPage = {$clubdirectory.pageBrowser.itemsPerPage}
    }
  }
}

# The list and detail view render links for the logged-in frontend user
# (e.g. edit link for the owner of a club). The page cache only varies by
# usergroup, so render the plugin uncached as soon as a user is logged in.
[frontend.user.isLoggedIn]
  tt_content.clubdirectory_clubdirectory.20 >
  tt_content.clubdirectory_clubdirectory.20 = COA_INT
  tt_content.clubdirectory_clubdirectory.20.10 = EXTBASEPLUGIN
  tt_content.clubdirectory_clubdirectory.20.10 {
    extensionName = Clubdirectory
    pluginName = Clubdirectory
  }
[END]
